# Backend tunables — all optional. Copy to `.env` and edit.
# Lines starting with # are ignored.

# Pipeline
MAX_REMEDIATION_LOOPS=3
REQUEST_TIMEOUT_SECONDS=120
MAX_REQUEST_BYTES=65536

# Per-agent sampling
BUILDER_TEMPERATURE=0.4
REVIEWER_TEMPERATURE=0.1
REMEDIATION_TEMPERATURE=0.3
MASTER_TEMPERATURE=0.1

# Per-agent max output tokens
BUILDER_MAX_TOKENS=2048
REVIEWER_MAX_TOKENS=512
REMEDIATION_MAX_TOKENS=2048
MASTER_MAX_TOKENS=512

# Retry on transient upstream errors (timeouts, 5xx)
UPSTREAM_RETRIES=2
UPSTREAM_RETRY_BACKOFF=0.6

# CORS — set to your frontend origin in production
CORS_ALLOW_ORIGIN=*

# Server
HOST=0.0.0.0
PORT=5000
FLASK_DEBUG=false
