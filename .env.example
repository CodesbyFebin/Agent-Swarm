# Core
NODE_ENV=development
DATABASE_URL=postgres://agentswarm:agentswarm@localhost:5432/agentswarm
API_PORT=8787
WEB_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:8787

# Redis — coordination/dispatch only, never the source of mission truth.
# Leave unset to run the worker in Postgres-poll-only mode (still correct,
# just higher dispatch latency).
REDIS_URL=redis://localhost:6379

# Qwen / Alibaba Cloud Model Studio
# Set the exact OpenAI-compatible base URL for your Model Studio region/workspace.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=qwen-plus
QWEN_REQUEST_TIMEOUT_MS=120000

# Worker
WORKER_ID=worker-local-1
WORKER_FALLBACK_POLL_MS=5000
WORKER_CONCURRENCY=4
TASK_LEASE_SECONDS=90
MAX_TASK_ATTEMPTS=3
